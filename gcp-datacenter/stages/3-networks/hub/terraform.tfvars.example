# Copiar a terraform.tfvars (excluido por .gitignore). En CI llegan como TF_VAR_*.
state_bucket = "acme-tf-state-xxxx"
prefix       = "acme"

labels = {
  app         = "landing-zone"
  owner       = "platform"
  cost_center = "infra"
}

# HA VPN y Cloud Router en ambas regiones (us-east4 = DR). Para un laboratorio barato, solo ["us-central1"].
vpn_regions = ["us-central1", "us-east4"]

# Vacío: se reenvía al forwarder entrante de onprem-sim. Con un on-prem real, poner aquí sus DNS.
onprem_dns_target_ips = []
