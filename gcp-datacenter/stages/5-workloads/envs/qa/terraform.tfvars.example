# Copiar a terraform.tfvars (excluido por .gitignore). En CI llegan como TF_VAR_*.
state_bucket       = "acme-tf-state-xxxx"
prefix             = "acme"
notification_email = "noc@example.com"

labels = {
  app         = "landing-zone"
  owner       = "platform"
  cost_center = "infra"
}

# qa: zonal, sin HA, sin réplica DR, bucket regional y sin protección contra borrado.
regional            = false
deletion_protection = false
sql_ha              = false
enable_dr_replica   = false
bucket_dual_region  = false
